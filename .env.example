# ==========================================
# ApexInspect AI Environment Configuration
# ==========================================

# 1. Database (Leave blank to use local SQLite: sqlite:///./factory.db)
# Neon.tech Free Postgres: postgresql://user:pass@ep-cool-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. LLM Provider — DEPLOYMENT CHỐT: Edge-First (offline on-premise).
# Default RCA = Local/Deterministic tại Edge (Heuristic + BM25 thuần).
# Options: 'deterministic' (safe default, no LLM calls), 'local' (Ollama on this
# machine), 'cloud' (Groq = async reporting only, never in critical path). Cloud is optional.
APEX_LLM_MODE=deterministic
# Local model for APEX_LLM_MODE=local (M1 Pro 16GB: qwen2.5:3b via Ollama at
# http://localhost:11434 — set OLLAMA_BASE_URL to override the host).
LOCAL_MODEL=qwen2.5:3b

# If APEX_LLM_MODE=cloud: Groq API (Free tier at console.groq.com) — ASYNC REPORTING ONLY,
# never in Edge critical path (Edge-First: offline 100% without cloud).
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# 3. Vision & Model Settings
MODEL_PATH=models/yolov8n_pcb_defect.onnx
CONFIDENCE_THRESHOLD=0.50
SIMULATE_CAMERA_STREAM=true
# Ground-truth fallback is a DEMO-ONLY escape hatch (synthetic frames). Keep
# false in production so a clean board is reported as PASS, never faked.
ALLOW_GT_FALLBACK=false

# 4. PLC actuation safety. Simulation is the default and never contacts a PLC.
# Set to hardware only on an approved line with a reachable PLC; failed writes stay FAILED.
APEX_PLC_MODE=simulation
PLC_HOST=127.0.0.1
PLC_PORT=5020

# 5. App & Server Settings
APP_PORT=8501
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 6. Local Ollama RAM guard (M1 Pro 16GB: 1 request song song, 1 model trong RAM, unload sau 5m idle)
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
