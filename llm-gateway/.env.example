# LLM Gateway configuration. Copy to .env and edit.
#
#   LLM_UPSTREAM   REQUIRED  Comma-separated fallback chain of OpenAI-compatible bases.
#                            First reachable one wins and is then reused (sticky).
#                            A missing scheme defaults to http://, a missing /v1 suffix
#                            is appended, an /api suffix is rewritten to /v1.
#   LLM_CHAT_MODEL default   Chat model id. Always present in GET /v1/models, even if
#                            the upstream list omits it.
#   LLM_EMBED_MODEL default  Embedding model id. Same treatment as LLM_CHAT_MODEL.
#   LLM_TIMEOUT   120       Per-request upstream timeout, seconds (float ok).
#   LLM_LOG_PATH  ./logs/llm-telemetry.jsonl
#                            Telemetry JSONL file. Prompt bodies are never written,
#                            only sizes + sha256.
#   LLM_LOG_MAX_MB 10       Rotate LLM_LOG_PATH to LLM_LOG_PATH.1 once it exceeds this
#                            size. Exactly 1 previous file is kept.
#   PORT          8787      Port the gateway listens on. This is the canonical name.
#   GATEWAY_PORT  unset     DEPRECATED alias for PORT. Only read when PORT is unset.
#   GATEWAY_HOST  127.0.0.1 Bind address. Loopback by default; Docker overrides this
#                            to 0.0.0.0 (see docker-compose.yml) because the port has
#                            to be published outside the container.

# LLM upstream. LM Studio on the LAN, with local Ollama as a fallback:
LLM_UPSTREAM=http://192.168.1.8:1234/v1,http://127.0.0.1:11434/v1
# Model ids served by the upstream host.
LLM_CHAT_MODEL=qwen2.5-vl-3b-instruct
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

LLM_TIMEOUT=120
LLM_LOG_PATH=./logs/llm-telemetry.jsonl
LLM_LOG_MAX_MB=10

# --- v2: task routing (7 LAN models; each slot overridable) ---
# LLM_MODEL_FAST=qwen2.5-vl-3b-instruct
# LLM_MODEL_REASONING=deepseek/deepseek-r1-0528-qwen3-8b
# LLM_MODEL_VISION=qwen2.5-vl-3b-instruct
# LLM_MODEL_VISION_ALT=zai-org/glm-4.6v-flash
# LLM_MODEL_EMBED=text-embedding-nomic-embed-text-v1.5
# LLM_MODEL_GENERAL=google/gemma-4-e4b
# LLM_MODEL_LONG=google/gemma-4-e4b

# --- v2: resilience ---
# Circuit breaker: open after N consecutive failures, half-open trial after S seconds.
LLM_CB_FAILURE_THRESHOLD=5
LLM_CB_OPEN_SECONDS=30
# Retry on transport errors + 429/502/503/504: attempts + base backoff (full jitter).
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=50

# --- v2: governance ---
# VN PII masking (phone + CCCD/CMND) before prompts leave the gateway. 1 = on.
LLM_PII_MASKING=1
# Daily token quota per project (0 = unlimited). 429 when exceeded.
LLM_QUOTA_TOKENS_PER_DAY=0
# Assumed commercial price for cost-saved metrics (USD per 1M tokens).
LLM_COST_PER_1M_USD=10.0

# --- v2: hybrid cloud failover (demo never dies when LAN is unreachable) ---
# OpenAI-compatible cloud base tried ONCE after the LAN chain is exhausted.
# Example Cloudflare Workers AI gateway; leave unset for LAN-only mode.
# LLM_CLOUD_UPSTREAM=https://gateway.ai.cloudflare.com/v1/ACCOUNT_ID/CF_GATEWAY/openai
# LLM_CLOUD_API_KEY=
# LLM_CLOUD_MODEL=@cf/meta/llama-3.1-8b-instruct
# LLM_CLOUD_MODEL_REMAP=1

PORT=8787
